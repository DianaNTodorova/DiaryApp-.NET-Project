@model DiaryEntry


<div class="container mt-4">

    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header bg-primary" style="border-radius:0.5rem; border:1px;">
                <h2 style="color: white; padding-top:0.75rem; padding-bottom:0.75rem;padding-left:0.35rem;">Delete Diary Entry</h2>
            </div>
            <div class="card-body">
                <form asp-action="Delete" method="post">
                    <div class="form-group mb-3">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" class="form-control" placeholder="Enter a title" />
                        <span asp-validation-for="Title" class="text-danger pt-2" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Content" class="form-label"></label>
                        <textarea asp-for="Content" rows="5" class="form-control" placeholder="Enter what you did that day"></textarea>
                        <span asp-validation-for="Content" class="text-danger pt-2" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Created" class="form-label"></label>
                        <input asp-for="Created" class="form-control" type="date" />
                        <span asp-validation-for="Created" class="text-danger pt-2" />
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <a asp-controller="DiaryEntries" asp-action="Index" class="btn btn-danger">Cancel</a>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
